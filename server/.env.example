# Copy this file to .env and fill in your own values. Never commit .env to GitHub.

PORT=5000
NODE_ENV=development

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/acxiomcrm

# Long random string used to sign login tokens
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=8h

# Comma-separated list of frontend URLs allowed by CORS
CLIENT_URL=http://localhost:5173

# Account lockout policy
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
